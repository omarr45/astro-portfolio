---
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Heading from '../ui/Heading.astro';
const { data: stack } = await getEntry('stack', 'tech-stack');
---

<section class='w-full space-y-4'>
  <Heading>Tech Stack / Skills</Heading>
  <ul class='grid grid-cols-3 gap-4 md:grid-cols-6'>
    {
      stack.map((i) => (
        <li class='rounded-xl bg-foreground/5 p-5 transition-transform md:hover:scale-110'>
          <Icon
            name={i.icon}
            title={i.title}
            size={85}
            class={`${i.title === 'Shadcn/ui' ? 'invert-on-dark' : ''}`}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  html[data-theme='dark'] {
    .invert-on-dark {
      filter: invert(1);
    }
  }
</style>
